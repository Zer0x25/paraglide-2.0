# PostgreSQL local y Docker
# La DB de PRODUCCIÓN usa POSTGRES_HOST_PORT (5678) y postgres_data_v18.
# La DB de DESARROLLO es aislada (docker-compose.dev-db.yml) en 5679 con
# su propio volumen; apunta DATABASE_URL de dev a ella para que las Dev Tools
# (reset-db/simulate) jamás toquen datos de producción.
# La DB de STAGING es aislada (docker-compose.staging.yml) en 5680 con
# su propio volumen (postgres_staging_data), API en 3201 y Web en 3200.
POSTGRES_IMAGE="postgres:18.4-alpine"
POSTGRES_USER="admin"
POSTGRES_PASSWORD="adminpassword"
POSTGRES_DB="parapente_db"
POSTGRES_HOST_PORT=5678
POSTGRES_DB_DEV="parapente_dev_db"
POSTGRES_DEV_HOST_PORT=5679

# Staging (docker-compose.staging.yml)
POSTGRES_DB_STAGING="parapente_staging_db"
POSTGRES_STAGING_HOST_PORT=5680
STAGING_API_HOST_PORT=3201
STAGING_WEB_HOST_PORT=3200
DOCKER_STAGING_DATABASE_URL="postgresql://admin:adminpassword@db:5432/parapente_staging_db?connection_limit=10"

DATABASE_URL="postgresql://admin:adminpassword@localhost:5679/parapente_dev_db?connection_limit=10"
DOCKER_DATABASE_URL="postgresql://admin:adminpassword@db:5432/parapente_db?connection_limit=10"

# Secreto para firma de tokens JWT
JWT_SECRET="supersecretjwtkey_cambiar_en_produccion"

# API Fastify
HOST="0.0.0.0"
PORT=3001
API_CONTAINER_PORT=3001
API_HOST_PORT=3101

# URL de la API consumida por el frontend
NEXT_PUBLIC_API_URL="/api"
INTERNAL_API_URL="http://localhost:3001"
DOCKER_INTERNAL_API_URL="http://api:3001"

# Imágenes Docker publicadas en GHCR (el CI las construye, el servidor solo hace pull).
# No hace falta definirlas: docker-compose.yml usa estos valores por defecto.
# Para rollback manual, apunta a un tag inmutable: API_IMAGE=ghcr.io/zer0x25/paraglide-2.0-api:sha-<hash>
# API_IMAGE="ghcr.io/zer0x25/paraglide-2.0-api:latest"
# WEB_IMAGE="ghcr.io/zer0x25/paraglide-2.0-web:latest"
# URL pública de la app web (se usa para construir los enlaces del tablero /pantalla que se envían por WhatsApp)
PUBLIC_WEB_URL="http://localhost:3000"
DOCKER_NODE_ENV="production"

# Observabilidad (ADR 011)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Frontend y herramientas
WEB_CONTAINER_PORT=3000
WEB_HOST_PORT=3100
WEB_BASE_URL="http://localhost:3000"
# Dev: orígenes permitidos para Next (HMR / _next). Cubre localhost + LAN + Tailscale.
# Ver comentario en .env real para explicación de wildcards.
ALLOWED_DEV_ORIGINS="localhost,10.*.*.*,192.168.*.*,172.*.*.*,100.*.*.*,*.ts.net,*.tailscale.net"
API_URL="http://localhost:3001/api"

# CORS del API (producción): lista de orígenes permitidos separados por coma,
# p.ej. "https://parapente.app" o "https://parapente.app,http://192.168.1.50:3100".
# - Match EXACTO: esquema + dominio + puerto, sin barra final.
# - Sin esta variable, el API bloquea todo request cross-origin desde navegador
#   (las peticiones sin Origin —curl, server-to-server, el proxy de Next— pasan).
# - En desarrollo (NODE_ENV != production) se permite cualquier origen, no aplica.
# - El flujo normal de prod NO la necesita: el navegador solo habla con la web
#   (:3100) y Next reescribe /api/* al API interno (mismo origen => sin CORS).
#   Solo hace falta si un cliente en otro origen llama directo al API (:3101),
#   p.ej. la pantalla TV embebida desde otro dominio.
ALLOWED_ORIGINS="https://parapente.app"

# Entorno
NODE_ENV="development"

# Ubicación del centro de vuelo para el módulo de meteorología (Open-Meteo, sin API key).
# Latitud/longitud en grados decimales. Por defecto Iquique / Alto Hospicio, Chile.
CENTRO_LAT="-20.27"
CENTRO_LON="-70.13"

# OAuth Google (login con Google)
GOOGLE_CLIENT_ID=""
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""  # mismo valor que GOOGLE_CLIENT_ID pero con prefijo NEXT_PUBLIC_ para el frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Google Calendar API (Service Account - Sincronización en tiempo real)
GOOGLE_CALENDAR_ID=""
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""

# ============================================================
# MÓDULOS PREMIUM (opcionales)
# La activación de módulos (equipos, reportes,
# meteorologia, pantalla, plantillas) es RUNTIME y versionada en
# el repo: `apps/api/modules.config.json` + `GET/PUT /api/admin/modules`
# (toggle en `/admin/modules`). No hay variables de entorno para esto.
# ============================================================
