{
  "name": "parapente-reservas-monorepo",
  "version": "0.9.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:pwa": "npm run dev:pwa --workspace=web",
    "preview:pwa": "npm run build:web && npm run start --workspace=web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:shared": "npm run build --workspace=@parapente/shared",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:mcp": "npm run build --workspace=@parapente/mcp",
    "build": "npm run build:shared && npm run build:api && npm run build:web && npm run build:mcp",
    "test:api": "npm run test --workspace=api",
    "test:api:integration": "npm run test:integration --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test:mcp": "npm run test --workspace=@parapente/mcp",
    "test:e2e": "npm run test:e2e --workspace=web",
    "test:dev:full": "npm run check:quick && npm run test:api:integration && npm run test:e2e",
    "test:prod": "tsx scripts/test-prod-suite.ts",
    "test:prod:wait": "tsx scripts/test-prod-suite.ts --wait",
    "test:fase2": "tsx scripts/test-fase2-suite.ts",
    "test:fase2:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase2-suite.ts",
    "test:fase3": "tsx scripts/test-fase3-suite.ts",
    "test:fase3:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase3-suite.ts",
    "test:fase4": "tsx scripts/test-fase4-suite.ts",
    "test:fase4:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase4-suite.ts",
    "test:fase5": "tsx scripts/test-fase5-ciclo-vida.ts",
    "test:fase5:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase5-ciclo-vida.ts",
    "test:fase6": "tsx scripts/test-fase6-concurrencia-sse.ts",
    "test:fase6:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase6-concurrencia-sse.ts",
    "test:fase7": "tsx scripts/test-fase7-integraciones.ts",
    "test:fase7:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase7-integraciones.ts",
    "test:fase8": "tsx scripts/test-fase8-performance.ts",
    "test:fase8:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase8-performance.ts",
    "test:fase9": "tsx scripts/test-fase9-flujos-complejos.ts",
    "test:fase9:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-fase9-flujos-complejos.ts",
    "test:calendar:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-calendar-prod.ts",
    "test:mvp": "tsx scripts/test-mvp-stress.ts",
    "test:mvp:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-mvp-stress.ts",
    "test:staging:mvp": "PROD_URL=http://localhost:3200 tsx scripts/test-mvp-stress.ts",
    "test:reagenda": "tsx scripts/test-reagenda-stress.ts",
    "test:reagenda:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-reagenda-stress.ts",
    "test:staging:reagenda": "PROD_URL=http://localhost:3200 tsx scripts/test-reagenda-stress.ts",
    "test:reservas": "tsx scripts/test-reservas-pasajeros-stress.ts",
    "test:reservas:prod": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-reservas-pasajeros-stress.ts",
    "test:staging:reservas": "PROD_URL=http://localhost:3200 tsx scripts/test-reservas-pasajeros-stress.ts",
    "deploy:status": "bash scripts/deploy-status.sh",
    "staging:up": "docker compose -f docker-compose.staging.yml up -d --build",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "staging:down:volumes": "docker compose -f docker-compose.staging.yml down -v",
    "staging:logs": "docker compose -f docker-compose.staging.yml logs -f",
    "staging:ps": "docker compose -f docker-compose.staging.yml ps",
    "staging:seed": "docker compose -f docker-compose.staging.yml exec api npx prisma db push --schema=apps/api/prisma/schema.prisma --skip-generate --accept-data-loss && docker compose -f docker-compose.staging.yml exec api npx tsx apps/api/prisma/seed.ts && docker compose -f docker-compose.staging.yml exec api npx tsx apps/api/scripts/indexes-especiales.ts",
    "test:staging": "tsx scripts/test-staging.ts --all",
    "test:staging:quick": "tsx scripts/test-staging.ts --suite=01,02",
    "test:staging:stress": "tsx scripts/test-staging.ts --suite=05",
    "test:staging:tz": "tsx scripts/test-datetime-tz-stress.ts",
    "test:staging:wait": "tsx scripts/test-staging.ts --all --wait",
    "test:prod:all": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-staging.ts --all",
    "test:prod:wait:all": "PROD_URL=https://parapente.zer0x.org tsx scripts/test-staging.ts --all --wait",
    "test:staging:fase2": "PROD_URL=http://localhost:3200 tsx scripts/test-fase2-suite.ts",
    "test:staging:fase3": "PROD_URL=http://localhost:3200 tsx scripts/test-fase3-suite.ts",
    "test:staging:fase4": "PROD_URL=http://localhost:3200 tsx scripts/test-fase4-suite.ts",
    "test:staging:fase5": "PROD_URL=http://localhost:3200 tsx scripts/test-fase5-ciclo-vida.ts",
    "test:staging:fase6": "PROD_URL=http://localhost:3200 tsx scripts/test-fase6-concurrencia-sse.ts",
    "test:staging:fase7": "PROD_URL=http://localhost:3200 tsx scripts/test-fase7-integraciones.ts",
    "test:staging:fase8": "PROD_URL=http://localhost:3200 tsx scripts/test-fase8-performance.ts",
    "test:staging:fase9": "PROD_URL=http://localhost:3200 tsx scripts/test-fase9-flujos-complejos.ts",
    "test:staging:calendar": "PROD_URL=http://localhost:3200 tsx scripts/test-calendar-prod.ts",
    "test": "npm run build:shared && npm run test:api && npm run test:web && npm run test:mcp",
    "typecheck": "npm run typecheck --workspace=@parapente/shared && npm run typecheck --workspace=api && npm run typecheck --workspace=web && npm run typecheck --workspace=@parapente/mcp",
    "lint": "npm run lint --workspace=web",
    "lint:report": "node scripts/lint-report.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "check:quick": "npm run build:shared && npm run typecheck && npm run test:api && npm run test:web && npm run test:mcp",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@sentry/cli@2.58.6": true,
    "@sentry/node-cpu-profiler@2.4.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.5": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "serialize-javascript": "7.1.0"
  }
}
